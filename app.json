{
  "expo": {
    "name": "Memora",
    "slug": "memora",
    "version": "1.0.1",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "memora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.memoraco.memora",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "jsEngine": "hermes",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.anhtdse184525.Memora",
      "versionCode": 18
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#ffffff",
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-audio",
      "expo-font",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true,
            "gradleProperties": {
              "newArchEnabled": "true",
              "hermesEnabled": "true"
            }
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "visible": "immersive",
          "behavior": "overlay-swipe",
          "barStyle": "light",
          "backgroundColor": "#00000000"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ea7897cd-c84b-4f2f-974d-09a943c7643e"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/3a42b0df-db99-4691-a07a-0229126d17e3"
    }
  }
}
